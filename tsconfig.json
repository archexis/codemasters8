{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "allowJs": true, "checkJs": false, "resolveJsonModule": true,
    "isolatedModules": true, "verbatimModuleSyntax": true, "esModuleInterop": true,
    "skipLibCheck": true, "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "tests/**/*.ts", "playwright*.config.ts"]
}
