# Public frontend configuration. Empty values select browser-local demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:8000
# FastAPI: use the anon/publishable key, never a service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Registry import: server-only secrets and an operator-verified construction dataset.
# EGOV_DATASET is the exact dataset/version pair, for example the values from its passport.
IMPORT_DB_PATH=backend/.data/imports.sqlite3
EGOV_API_KEY=
EGOV_DATASET=
EGOV_FIELD_MAP=
EGOV_CITY_QUERY=Усть-Каменогорск
# Optional address geocoder. Empty = leave missing coordinates for manual review.
GEOAPIFY_API_KEY=
# Edge Function secrets only; never prefix with VITE_.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=
LLM_API_KEY=
# DeepSeek Flash: set disabled for bounded latency in extraction tests.
LLM_THINKING=
ALLOWED_ORIGIN=http://localhost:5173
# Trusted analysis_runs writer: supplied automatically by local Supabase runtime.
# Only Edge/server; never VITE_, browser, public logs, or a committed .env file.
SUPABASE_SERVICE_ROLE_KEY=
