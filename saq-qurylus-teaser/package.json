{
  "name": "saq-qurylus-teaser",
  "version": "1.0.0",
  "description": "SAQ QURYLYS cinematic 15-second demonstrator",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "@remotion/media": "4.0.537",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render": "node scripts/render.mjs",
    "frames": "remotion render src/index.ts SAQQurylusTeaser out/frames --frames=0,30,60,90,120,150,210,260,320,350,375,405,449 --image-format=png",
    "cover": "remotion still src/index.ts SAQQurylusCover out/saq-qurylus-cover.png",
    "audio": "python scripts/synthesize_audio.py",
    "validate": "python scripts/validate_render.py",
    "music:apply": "node scripts/apply_music.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
