{
  "name": "saq-qurylys",
  "private": true,
  "license": "MIT",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --max-warnings=160",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:cloud": "playwright test --config playwright.cloud.config.ts",
    "test:edge": "npx --yes deno test --allow-env supabase/functions/analyze/index.test.ts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:local": "node tools/local-smoke.mjs",
    "test:deepseek": "node tools/deepseek-smoke.mjs",
    "test:api": "node tools/run-api-tests.mjs",
    "buildings:fetch": "python tools/import-city-buildings.py",
    "buildings:tiles": "node tools/tile-city-buildings.mjs",
    "migrate:safe": "node tools/migrate-safe.mjs",
    "verify:score": "node tools/score-maxxing-verify.mjs",
    "verify-all": "npm run check && npm test && npm run build && npm run test:e2e && npm run test:cloud && npm run test:api && npm run test:edge",
    "gate": "node tools/check-sprint-gate.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "maplibre-gl": "^6.14.0",
    "papaparse": "^5.5.0",
    "svelte": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@maplibre/geojson-vt": "6.3.0",
    "@maplibre/vt-pbf": "4.3.2",
    "@playwright/test": "^1.56.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
